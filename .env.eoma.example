# EOMA Integration Configuration
# Copy to .env and fill in values

# === Core Settings
MAIN_URL=https://social-api.eoma.co
FRONTEND_URL=https://app.eoma.co
NEXT_PUBLIC_BACKEND_URL=https://social-api.eoma.co/api
JWT_SECRET=generate-a-random-string-here
BACKEND_INTERNAL_URL=http://localhost:3000
IS_GENERAL=true

# === Database (Supabase direct connection — postiz schema)
DATABASE_URL=postgresql://postgres.[supabase-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# === Redis (Railway managed)
REDIS_URL=redis://default:[password]@[railway-redis-host]:6379

# === Temporal (Railway managed)
TEMPORAL_ADDRESS=temporal-server.railway.internal:7233

# === EOMA-Specific Flags
DISABLE_BILLING_CHECKS=true
DISABLE_EMAILS=true
DISABLE_PUBLIC_SIGNUP=true
BACKEND_PROXY_URL=https://api.eoma.co
FRONTEND_REDIRECT_URL=https://app.eoma.co

# === Storage (Cloudflare R2 recommended for production)
STORAGE_PROVIDER=local
UPLOAD_DIRECTORY=/uploads
NEXT_PUBLIC_UPLOAD_DIRECTORY=/uploads

# === Social Media OAuth Credentials (register at each platform's developer portal)
X_API_KEY=
X_API_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
THREADS_APP_ID=
THREADS_APP_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=

# === AI Content Generation
OPENAI_API_KEY=

# === Short Link Service (Optional)
# DUB_TOKEN=
# SHORT_IO_SECRET_KEY=

# === Misc
API_LIMIT=100
NX_ADD_PLUGINS=false
DISABLE_REGISTRATION=true
